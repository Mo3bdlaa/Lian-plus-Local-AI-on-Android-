<?xml version="1.0" encoding="utf-8"?>
<!--
    The icon's backdrop: a deep navy with a violet bloom in the top-left
    corner, sampled from the source artwork so the adaptive icon matches it
    once the launcher applies its own mask.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#1B1A3C"
                android:centerColor="#0C1026"
                android:endColor="#050612" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="60%"
                android:centerX="0.22"
                android:centerY="0.20"
                android:startColor="#7A5BC4"
                android:centerColor="#3A2F6B"
                android:endColor="#00050612" />
        </shape>
    </item>
</layer-list>
