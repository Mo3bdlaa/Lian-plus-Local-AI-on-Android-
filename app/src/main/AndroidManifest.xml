<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Downloading weights and, when the user turns it on, web search. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The API server and long generations must survive the screen going off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Inference is CPU and memory bound; 64-bit Arm is required. -->
    <uses-feature android:name="android.hardware.ram.low" android:required="false" />

    <application
        android:name=".LianApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LianPlus"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.LianPlus.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The local OpenAI-compatible API. -->
        <service
            android:name=".server.ServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            The diffusion engine runs in its own process. That keeps its very
            large transient allocations out of the process holding the language
            model, lets the OS reclaim every byte when it exits, and guarantees
            its statically linked ggml never shares an address space with the
            copy inside the text engine.
        -->
        <!--
            Runs in the foreground while a model is resident or a generation is
            in flight. Without that it is an ordinary background process, and
            Android reclaims those first - the client then sees the model
            having silently "unloaded itself" mid-run.
        -->
        <service
            android:name=".image.ImageGenService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:process=":imagegen" />

        <!--
            Model downloads are gigabytes over mobile data; the user will switch
            away long before one finishes.
        -->
        <service
            android:name=".hub.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
